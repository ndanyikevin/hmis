    "shared": "workspace:*",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.23.0"
  }
